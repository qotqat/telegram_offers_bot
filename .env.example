# ============================================================
# Telegram Offers Bot — configuration
# Copy to `.env` and fill in real values. Never commit `.env`.
# Required for launch: TG_API_ID, TG_API_HASH, BOT_TOKEN, OWNER_ID,
# TARGET_CHANNELS, SOURCE_CHANNELS.
# ============================================================

# --- Telegram user account (Telethon listener) ---
# From https://my.telegram.org -> API development tools.
# Use a SECONDARY account for the listener, never your main.
# TG_API_ID is numeric, e.g. 1234567
TG_API_ID=
TG_API_HASH=

# Telethon session file. In Docker this is /data/listener_session.
TG_SESSION_PATH=data/listener_session

# --- Broadcast bot ---
# From @BotFather (format 123456789:AA...). The bot must be admin with
# "Post messages" rights in EVERY channel in TARGET_CHANNELS.
BOT_TOKEN=

# Numeric Telegram user id of the owner (admin commands + crash alerts).
# Get it from @userinfobot.
OWNER_ID=

# --- Output channels ---
# Comma-separated @usernames or -100xxxxxxxxxx ids.
TARGET_CHANNELS=

# all   = every offer goes to every channel
# route = per-channel rules (see ROUTE_RULES)
CHANNEL_MODE=all

# Route mode only. Comma-separated rules: channel:match
# match = "ar" (Arabic text), "en", or a category/keyword (e.g. tech).
# An offer goes to every matching rule; if nothing matches it falls back
# to the primary (first) target channel. "*" matches everything.
ROUTE_RULES=

# --- Source channels (Telegram ingestion) ---
# Comma-separated @usernames that the listener account has already joined.
SOURCE_CHANNELS=

# Catch-up: on startup read the last N messages per source.
CATCHUP_LIMIT=50
# Pause between sources during catch-up (seconds), to stay gentle.
CATCHUP_DELAY_SECONDS=1.0

# --- Copied-post behavior (Amazon-only) ---
# Only ingest posts that contain an Amazon link. Their text is copied to the
# output channel with every Amazon link replaced by our affiliate link.
REQUIRE_AMAZON_LINK=1
# Replace source channel display names, @usernames and t.me links with ours.
BRAND_NAME=Your Deals Channel
BRAND_USERNAME=@your_channel
BRAND_URL=https://t.me/your_channel

# --- Filters / queue ---
# Minimum discount; applied only when the post has a parsed discount, so
# text-only Telegram posts still pass through.
MIN_DISCOUNT_PCT=20
# Case-insensitive, Arabic-aware title exclusions.
EXCLUDE_KEYWORDS=fake,scam,counterfeit
POST_INTERVAL_SECONDS=360
MAX_POSTS_PER_HOUR=10
# Max accepted offers per source channel per hour (anti-domination).
MAX_PER_SOURCE_PER_HOUR=3
# Near-duplicate check: last 500 accepted offers, same currency, +/-10% price
# bucket, canonical link match or rapidfuzz title ratio >= this value.
FUZZY_THRESHOLD=88

# --- Amazon (Creators API) ---
# Optional for launch: leave AMAZON_ENABLED=0 to ship Telegram-only.
# Flip to 1 once the Associates account has Creators API access (>=10
# qualifying sales in the rolling 30 days).
AMAZON_ENABLED=0
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
# From the downloaded credential CSV. 3.1 = North America, 3.2 = Europe,
# 3.3 = Far East. (2.x Cognito credentials must be regenerated.)
AMAZON_CREDENTIAL_VERSION=3.1
# Required even with AMAZON_ENABLED=0 when REQUIRE_AMAZON_LINK=1: it replaces
# the source channel's tag on every copied Amazon link.
AMAZON_ASSOCIATE_TAG=
# Storefront host for rebuilt product links (e.g. www.amazon.eg for Egypt).
AMAZON_MARKETPLACE=www.amazon.com
# One SearchItems request per keyword (max 10 items each), comma-separated.
AMAZON_KEYWORDS=headphones,smart watch,air fryer,robot vacuum
AMAZON_ITEM_COUNT=10
AMAZON_MIN_DISCOUNT_PCT=20
# Pause between keyword requests (seconds) to stay inside the quota.
AMAZON_REQUEST_DELAY_SECONDS=1.0
AMAZON_POLL_INTERVAL_MINUTES=30

# --- Storage / logging ---
# In Docker these live on the shared /data volume.
DB_PATH=data/offers.db
# Downloaded Telegram photos for reposting.
MEDIA_DIR=data/media
MAX_IMAGE_BYTES=1048576
LOG_PATH=data/bot.log
LOG_LEVEL=INFO
